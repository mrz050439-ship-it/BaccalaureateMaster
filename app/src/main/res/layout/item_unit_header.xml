<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingTop="14dp" android:paddingBottom="8dp">
    <View android:id="@+id/viewAccent" android:layout_width="5dp"
        android:layout_height="30dp" android:background="@color/primary" />
    <TextView android:id="@+id/tvUnitTitle" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_marginStart="10dp"
        android:layout_weight="1" android:textColor="@color/text" android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
