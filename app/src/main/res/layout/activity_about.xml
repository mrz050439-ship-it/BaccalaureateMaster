<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_header" android:orientation="vertical" android:padding="20dp">
        <TextView android:id="@+id/btnBack" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:padding="6dp" android:text="→ رجوع" android:textColor="@color/white"
            android:textSize="15sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="🎓 نظام البكالوريا المصرية"
            android:textColor="@color/white" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="كل ما تحتاج تعرفه عن نظامك"
            android:textColor="#DAD7FE" android:textSize="13sp" />
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/card_white" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="📌 الفكرة" android:textColor="@color/text"
                    android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="البكالوريا هي نظام الثانوية الجديد بديل الثانوية العامة، بدأ بدفعة الصف الأول الثانوي 2025/2026. سنة تمهيدية (أولى) ثم مرحلة الشهادة (تانية وتالتة) بأربعة مسارات: الطب وعلوم الحياة، الهندسة وعلوم الحاسب، الأعمال، والآداب والفنون."
                    android:textColor="@color/text_secondary" android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:background="@drawable/card_white"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="🎯 المجموع" android:textColor="@color/text"
                    android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="مجموع الشهادة 600 درجة: الصف الثاني 400 درجة (عربي + لغة أولى + تاريخ + مادة تخصص)، والصف الثالث 200 درجة (مادتا تخصص). كل مادة من 100 درجة."
                    android:textColor="@color/text_secondary" android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:background="@drawable/card_white"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="📝 الامتحانات" android:textColor="@color/text"
                    android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="شكل الامتحان: 50% اختيار من متعدد و50% مقالي. فرصتان كل عام (مايو إجبارية مجانية + يوليو اختيارية برسوم)، والدرجة الأعلى هي التي تُحتسب. أول محاولة في سنتها الدراسية، والإعادة متاحة بحد أقصى 4 سنوات في المرحلة الرئيسية."
                    android:textColor="@color/text_secondary" android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:background="@drawable/card_white"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="✅ شرط دخول الامتحان" android:textColor="@color/text"
                    android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="إنجاز 60% من التقييمات والأداءات لكل مادة: مشروع 15 + تقييم أسبوعي 20 + أداء منزلي وحصة 15 + سلوك ومواظبة 10 + تقييمان شهريان 40."
                    android:textColor="@color/text_secondary" android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:background="@drawable/card_white"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="🔀 تغيير المسار" android:textColor="@color/text"
                    android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="تغيير المسار ممكن بشرط دراسة مواد تخصص المسار الجديد: مادة الصف الثاني ومادتي الصف الثالث."
                    android:textColor="@color/text_secondary" android:textSize="14sp" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:gravity="center"
                android:text="المصدر: القرارات الوزارية المنظمة لشهادة البكالوريا وموقع وزارة التربية والتعليم"
                android:textColor="@color/text_secondary" android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
